{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/Debug/PIR.elf",
            "device": "STM32F446RE",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "runToEntryPoint": "main",
            "svdFile": "STM32F446.svd",
            "swoConfig": {
                "enabled": true,
                "cpuFrequency": 50000000,   // <--- METS TA FRÉQUENCE HCLK ICI (ex: 16000000)
                "swoFrequency": 2000000,    // Standard, ne touche pas
                "source": "probe",
                "decoders": [
                    {
                        "label": "ITM Port 0",
                        "number": 0,
                        "type": "console",
                        "port": 0
                    }
                ]
            }
        }
    ]
}
